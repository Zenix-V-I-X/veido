		})
		local dropdownFrame = Create("Frame", {
			Parent = dropdownHolder,
			Name = "DropdownFrame",
			Size = UDim2.new(0, 160, 0, 120),
			BackgroundColor3 = Color3.fromRGB(10, 20, 40),
			BackgroundTransparency = 0.05,
			AnchorPoint = Vector2.new(0, 0),
			ClipsDescendants = true,
			ZIndex = 500,
			Active = true
		})
		redzlib.Elements["Corner"](dropdownFrame, UDim.new(0, 6))
		ApplyMetallicBorder(dropdownFrame, 1.6)
		local dropdownScroll = Create("ScrollingFrame", {
			Parent = dropdownFrame,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = ThemeColors.Accent,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			BorderSizePixel = 0,
			ZIndex = 501,
			Active = true
		})
		Create("UIListLayout", dropdownScroll, { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder })
		Create("UIPadding", dropdownScroll, {
			PaddingLeft = UDim.new(0, 5),
			PaddingRight = UDim.new(0, 5),
			PaddingTop = UDim.new(0, 5),
			PaddingBottom = UDim.new(0, 5)
		})
		table.insert(openDropdowns, dropdownHolder)

		local function refresh(opts)
			for _, child in ipairs(dropdownScroll:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			for _, opt in ipairs(opts) do
				local b = Create("TextButton", dropdownScroll, {
					Size = UDim2.new(1, 0, 0, 22),
					Text = tostring(opt),
					BackgroundColor3 = ThemeColors.ButtonNormal,
					AutoButtonColor = false,
					TextColor3 = Theme["Color Text"],
					FontFace = UIFontFace,
					TextSize = 11,
					TextTruncate = Enum.TextTruncate.None,
					ZIndex = 502
				})
				redzlib.Elements["Corner"](b, UDim.new(0, 5))
				StyleInteractive(b)
				b.Activated:Connect(function()
					selected = opt
					valueBtn.Text = tostring(opt)
					dropdownHolder.Visible = false
					if type(cb) == "function" then cb(opt) end
				end)
			end
			dropdownFrame.Size = UDim2.new(0, 160, 0, math.min(#opts * 26 + 12, 140))
		end
		refresh(options)

		local function placeDropdown()
			local scale = ScreenGuiHub.Scale and ScreenGuiHub.Scale.Scale or 1
			local abs = valueBtn.AbsolutePosition
			local parentPos = ScreenGuiHub.AbsolutePosition
			dropdownFrame.Position = UDim2.fromOffset((abs.X - parentPos.X) / scale, (abs.Y - parentPos.Y + valueBtn.AbsoluteSize.Y + 4) / scale)
		end

		local function openDropdown()
			closeAllDropdowns()
			dropdownHolder.Visible = true
			task.defer(placeDropdown)
		end

		btn.Activated:Connect(function()
			if dropdownHolder.Visible then
				dropdownHolder.Visible = false
			else
				openDropdown()
			end
		end)
		valueBtn.Activated:Connect(function()
			if dropdownHolder.Visible then
				dropdownHolder.Visible = false
			else
				openDropdown()
			end
		end)
		dropdownHolder.Activated:Connect(function()
			dropdownHolder.Visible = false
		end)

		return {
			Refresh = function(_, opts)
				if opts then
					options = opts
					refresh(opts)
					valueBtn.Text = tostring(opts[1] or "")
					selected = opts[1] or ""
				end
			end
		}
	end

	return Tab
end

