	function Tab:AddToggle(Configs)
		local name = Configs[1] or Configs.Title or Configs.Name or "Toggle"
		local default = Configs[2] or Configs.Default or false
		local cb = Configs.Callback or Configs[3] or function() end
		local frame = Create("TextButton", Page, {
			Size = UDim2.new(1, -10, 0, 32),
			BackgroundColor3 = ThemeColors.ButtonNormal,
			Text = name,
			TextColor3 = ThemeColors.PureWhite,
			FontFace = UIFontFace,
