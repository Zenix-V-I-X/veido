			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			ZIndex = 4
		})
		Create("UIPadding", frame, { PaddingLeft = UDim.new(0, 10) })
		redzlib.Elements["Corner"](frame, UDim.new(0, 6))
		ApplyMetallicBorder(frame, 1.5)
		StyleInteractive(frame)

		local toggle = Create("Frame", {
			Parent = frame,
			Size = UDim2.new(0, 32, 0, 16),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = default and ThemeColors.Accent or Color3.fromRGB(40, 40, 50),
			ZIndex = 5
		})
		redzlib.Elements["Corner"](toggle, UDim.new(1, 0))

		local dot = Create("Frame", {
			Parent = toggle,
			Size = UDim2.new(0, 12, 0, 12),
			Position = default and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			ZIndex = 6
		})
		redzlib.Elements["Corner"](dot, UDim.new(1, 0))

		local state = default
		local function set(v)
			state = v
			Tween(toggle, { BackgroundColor3 = state and ThemeColors.Accent or Color3.fromRGB(40, 40, 50) }, 0.18)
			dot:TweenPosition(state and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0), "Out", "Quart", 0.2, true)
		end

		frame.Activated:Connect(function()
			set(not state)
			if type(cb) == "function" then cb(state) end
		end)
		return { SetToggle = set }
	end

	function Tab:AddSlider(Configs)
		local name = Configs[1] or Configs.Name or "Slider"
		local min = Configs[2] or Configs.Min or 0
		local max = Configs[3] or Configs.Max or 100
		local default = Configs[5] or Configs.Default or 25
		local cb = Configs.Callback or Configs[6] or function() end

		local btn = Create("TextButton", Page, {
			Size = UDim2.new(1, -10, 0, 36),
			BackgroundColor3 = ThemeColors.ButtonNormal,
			Text = name,
			TextColor3 = ThemeColors.PureWhite,
			FontFace = UIFontFace,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			ZIndex = 4
		})
		Create("UIPadding", btn, { PaddingLeft = UDim.new(0, 10) })
		redzlib.Elements["Corner"](btn, UDim.new(0, 6))
		ApplyMetallicBorder(btn, 1.5)

		local bar = Create("Frame", {
			Parent = btn,
			BackgroundColor3 = Color3.fromRGB(30, 30, 40),
			Size = UDim2.new(0, 100, 0, 6),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 5
		})
		redzlib.Elements["Corner"](bar, UDim.new(1, 0))

		local fill = Create("Frame", {
			Parent = bar,
			BackgroundColor3 = ThemeColors.Accent,
			Size = UDim2.fromScale((default - min) / math.max(max - min, 1), 1),
			ZIndex = 6
		})
		redzlib.Elements["Corner"](fill, UDim.new(1, 0))

		local label = Create("TextLabel", {
			Parent = btn,
			Size = UDim2.new(0, 36, 0, 14),
			Position = UDim2.new(1, -120, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Text = tostring(default),
			TextColor3 = Theme["Color Text"],
			FontFace = UIFontFace,
			TextSize = 10,
			BackgroundTransparency = 1,
			ZIndex = 5
		})

		local function updateSlider(input)
			local ratio = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
			local val = math.floor(min + (ratio * (max - min)))
			label.Text = tostring(val)
			fill.Size = UDim2.fromScale(ratio, 1)
			if type(cb) == "function" then cb(val) end
		end

		local activeInput = nil
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				activeInput = input
				updateSlider(input)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if input == activeInput then updateSlider(input) end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input == activeInput then activeInput = nil end
		end)
		return btn
	end

